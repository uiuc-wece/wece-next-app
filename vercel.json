{
  "version": 2,
  "framework": "nextjs",
  "github": {
    "enabled": false
  },
  "build": {
    "env": {
      "API_URL": "NEW_API_URL",
      "MONGODB_URL": "MONGODB_URL",
      "MAILERLITE_API_KEY": "MAILERLITE_API_KEY",
      "MAILERLITE_GROUP_ID": "MAILERLITE_GROUP_ID"
    }
  },
  "env": {
    "API_URL": "NEW_API_URL",
    "MONGODB_URL": "MONGODB_URL",
    "MAILERLITE_API_KEY": "MAILERLITE_API_KEY",
    "MAILERLITE_GROUP_ID": "MAILERLITE_GROUP_ID"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
